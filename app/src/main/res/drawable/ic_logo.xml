<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Blue Pocket -->
    <path
        android:fillColor="#152850"
        android:pathData="M50,80 h100 v60 c0,15 -15,30 -30,40 l-20,10 l-20,-10 c-15,-10 -30,-25 -30,-40 z"
        android:strokeColor="#70B0D0"
        android:strokeWidth="2"/>

    <!-- Joystick Base (Handheld) -->
    <path
        android:fillColor="#3A3C3E"
        android:pathData="M70,50 l60,0 l-5,30 l-50,0 z" />

    <!-- Joystick Stem -->
    <path
        android:fillColor="#1A1C1E"
        android:pathData="M95,30 h10 v25 h-10 z" />

    <!-- Joystick Ball (Red) -->
    <path
        android:fillColor="#E03030"
        android:pathData="M100,10 a15,15 0,1,1 0,30 a15,15 0,1,1 0,-30" />

    <!-- Sparkle/Star (Yellow/Orange) -->
    <path
        android:fillColor="#FFD700"
        android:pathData="M120,10 l5,10 l10,2 l-8,8 l2,10 l-9,-6 l-9,6 l2,-10 l-8,-8 l10,-2 z" />

    <!-- Text area background (for better visibility) -->
    <!-- We skip text in vector to keep it clean, or use paths for letters -->

    <!-- "POCKET" (Red Block) -->
    <path
        android:fillColor="#E03030"
        android:pathData="M60,150 h80 v20 h-80 z" />

    <!-- "LAUNCHER" (Blue Block) -->
    <path
        android:fillColor="#70B0D0"
        android:pathData="M60,175 h80 v20 h-80 z" />

</vector>
